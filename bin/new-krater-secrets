#!/usr/bin/env bash
# Write Krater's two production secrets with new random values:
#   secrets/central-prod-krater.age  the password of the role krater in
#                                    patchwork_central on skein (password only)
#   secrets/krater-env.age           Krater's env file (modules/krater)
# Both files get the same password. The env file also gets a new
# KRATER_SECRET_KEY and screenshot-storage keys. KRATER_WEAVE_CLIENT_SECRET,
# KRATER_SLACK_BOT_TOKEN and KRATER_SLACK_SIGNING_SECRET stay empty, and Krater
# refuses to start in production until they are set. Fill them in later with
#   cd secrets && agenix -e krater-env.age
# The Weave client id, the issuer and the hostnames are not secret:
# hosts/alastor/krater.nix sets them.
#
# Usage: bin/new-krater-secrets [database host]
# The database host defaults to skein's tailnet name, for a Krater host that
# reaches skein over Tailscale. A host in the lab passes skein's LAN address.
# Needs agenix and openssl. The script never prints a value, and it stops if
# one of the files exists. The recipients come from secrets/secrets.nix.
set -euo pipefail

db_host="${1:-skein.wildebeest-stargazer.ts.net}"

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/secrets"

for tool in agenix openssl; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

for file in central-prod-krater.age krater-env.age; do
  if [ -e "$file" ]; then
    echo "secrets/$file exists. Stop. To change a value, use: agenix -e $file" >&2
    exit 1
  fi
done

umask 077
# Hex only, so the password needs no escaping in the URL.
password="$(openssl rand -hex 32)"
secret_key="$(openssl rand -hex 32)"
s3_secret="$(openssl rand -hex 32)"

# printf is a shell builtin, so the values are not in any process's arguments.
# agenix reads the cleartext from stdin when stdin is not a terminal.
printf '%s' "$password" | agenix -e central-prod-krater.age

{
  printf '%s\n' "KRATER_DATABASE_URL=postgresql+psycopg://krater:${password}@${db_host}:5432/patchwork_central?sslmode=disable"
  printf '%s\n' "KRATER_SECRET_KEY=${secret_key}"
  printf '%s\n' "KRATER_S3_ACCESS_KEY_ID=krater-prod"
  printf '%s\n' "KRATER_S3_SECRET_ACCESS_KEY=${s3_secret}"
  printf '%s\n' "KRATER_WEAVE_CLIENT_SECRET="
  printf '%s\n' "KRATER_SLACK_BOT_TOKEN="
  printf '%s\n' "KRATER_SLACK_SIGNING_SECRET="
} | agenix -e krater-env.age

unset password secret_key s3_secret

echo "Wrote secrets/central-prod-krater.age and secrets/krater-env.age."
echo "Next: add the Weave client secret and the Slack bot token and signing secret with"
echo "  cd secrets && agenix -e krater-env.age"
