      "displayName": "Jasper Mayone (Admin)", "title": "Tier 0 administrator", "manager": null },
    { "sam": "svc-ansible", "kind": "admin", "ou": "Admin-Accounts/Tier0", "create": false },

    { "sam": "vi", "kind": "disabled", "ou": "Disabled" },
    { "sam": "yc", "kind": "disabled", "ou": "Disabled" }
  ],

  "roleGroups": [
    { "name": "GG-Board", "description": "Board of Directors", "members": ["mayonej", "klukask", "petrarcad"] },
    { "name": "GG-President", "description": "President", "members": ["mayonej"] },
    { "name": "GG-Treasurer", "description": "Treasurer", "members": ["klukask"] },
    { "name": "GG-Secretary", "description": "Secretary", "members": ["klukask"] },
    { "name": "GG-Ganymede-Admins", "description": "Project Ganymede admins", "members": ["mayonej", "adam.sidwa"] },
    { "name": "GG-Ganymede-Users", "description": "Project Ganymede users", "members": [], "manageMembers": false },
    { "name": "GG-HackBoston-Organizers", "description": "HackBoston organizers", "members": ["cj", "daniel", "logan", "mayonej"] },
    { "name": "GG-HackathonHelp-Organizers", "description": "hackathon.help organizers", "members": ["wei"] },
    { "name": "GG-Infra", "description": "Infrastructure", "members": ["mayonej"] },
    { "name": "GG-All-Staff", "description": "Every person in org.json: staff, board, organizers. Gets PSO-Staff.",
      "members": ["mayonej", "adam.sidwa", "klukask", "petrarcad", "cj", "daniel", "logan", "wei"] },
    { "name": "GG-Service-Accounts", "description": "Service accounts. Gets PSO-Service.",
      "members": ["svc-service", "svc-lnx-join", "svc-dhcp-dns", "svc-pve-ldap", "svc-weave-ldap", "svc-ansible"] },
    { "name": "GG-Domain-Admins-Tier0", "description": "Tier 0 admin accounts. Member of Domain Admins. Gets PSO-Tier0.", "members": ["adm_mayonej"] },
    { "name": "GG-T0-Eligible", "description": "Tier 0 accounts that can request a JIT Domain Admins grant (PatchworkT0 JEA endpoint). Gets PSO-Tier0.",
      "members": ["adm_mayonej"] },
    { "name": "GG-T1-Admins", "description": "Tier 1 server admins. Computer objects in Servers and Computers, and the helpdesk rights. Tier 1 admin accounts only.",
      "members": [] },
    { "name": "GG-T2-Helpdesk", "description": "Tier 2 helpdesk. Reset, unlock and force a password change for people in Users/Staff, Board-Only, Sponsored-Projects.",
      "members": [] }
  ],

  "linuxHosts": ["hem", "seam", "skein", "warp"],
  "retiredHosts": ["sampler", "swatch"],
  "hostGroups": [
    { "name": "lnx-{host}-users", "description": "Linux logon on {host}", "members": ["GG-Infra"] },
    { "name": "lnx-{host}-admins", "description": "Linux sudo on {host}", "members": ["GG-Infra"] }
  ],
  "resourceGroups": [
    { "name": "DL-Users-PasswordReset", "description": "Reset password, unlock, change at next logon: Users/Staff, Board-Only, Sponsored-Projects",
      "members": ["GG-T2-Helpdesk", "GG-T1-Admins"] },
    { "name": "DL-Servers-ComputerAdmin", "description": "Full control of computer objects: Servers and Computers, not Servers/Tier0 or Domain Controllers",
      "members": ["GG-T1-Admins"] }
  ],

  "passwordPolicy": {
    "default": {
      "minPasswordLength": 12, "maxPasswordAgeDays": 0, "passwordHistoryCount": 24, "complexityEnabled": true,
      "lockoutThreshold": 10, "lockoutDurationMinutes": 15, "lockoutObservationWindowMinutes": 15
    },
    "psos": [
      { "name": "PSO-Tier0", "precedence": 10, "description": "Tier 0 admin accounts", "appliesTo": ["GG-Domain-Admins-Tier0", "GG-T0-Eligible"],
        "minPasswordLength": 20, "maxPasswordAgeDays": 0, "passwordHistoryCount": 24, "complexityEnabled": true,
        "lockoutThreshold": 5, "lockoutDurationMinutes": 30, "lockoutObservationWindowMinutes": 30 },
      { "name": "PSO-Service", "precedence": 20, "description": "Service accounts. No lockout, so a bad password cannot stop a service.",
        "appliesTo": ["GG-Service-Accounts"],
        "minPasswordLength": 32, "maxPasswordAgeDays": 0, "passwordHistoryCount": 24, "complexityEnabled": true,
        "lockoutThreshold": 0, "lockoutDurationMinutes": 15, "lockoutObservationWindowMinutes": 15 },
      { "name": "PSO-Staff", "precedence": 30, "description": "Staff, board and organizers", "appliesTo": ["GG-All-Staff"],
        "minPasswordLength": 14, "maxPasswordAgeDays": 0, "passwordHistoryCount": 24, "complexityEnabled": true,
        "lockoutThreshold": 10, "lockoutDurationMinutes": 15, "lockoutObservationWindowMinutes": 15 }
    ]
  },

  "builtinAdministrator": { "enabled": false, "removeFrom": ["Enterprise Admins", "Schema Admins"] },

  "privileged": {
    "tier0Group": "GG-Domain-Admins-Tier0",
    "groups": ["Domain Admins", "Enterprise Admins", "Schema Admins", "Administrators"],
    "allowedDirectMembers": {
      "Domain Admins": ["Administrator", "svc-ansible", "GG-Domain-Admins-Tier0"],
      "Enterprise Admins": [],
      "Schema Admins": [],
      "Administrators": ["Administrator", "Domain Admins", "Enterprise Admins"]
    }
  },

  "tiering": {
    "silo": "T0-Silo",
    "description": "Tier 0. Members get a TGT only on a Tier 0 device. See ad/TIERING.md.",
    "enforce": false,
    "userPolicy": { "name": "T0-User", "description": "Tier 0 users: 240 min TGT, only from a device in T0-Silo",
      "tgtMinutes": 240, "deviceInSilo": true },
    "computerPolicy": { "name": "T0-Computer", "description": "Tier 0 computers. No TGT lifetime, no conditions." },
    "servicePolicy": { "name": "T0-Service", "description": "svc-ansible after TIERING.md step 5b: 60 min TGT, no device condition. Not assigned yet.",
      "tgtMinutes": 60, "deviceInSilo": false, "inSilo": false, "enforce": false },
    "users": ["adm_mayonej"],
    "computers": ["LOOM", "SPINDLE", "BOBBIN", "SHUTTLE", "SPOOL"],
    "serverOU": "Servers/Tier0",
    "jit": { "enabled": false, "removeStanding": false, "group": "GG-Domain-Admins-Tier0", "eligible": "GG-T0-Eligible",
      "defaultHours": 1, "maxHours": 4, "standingGroups": ["DnsAdmins", "DHCP Administrators"] }
  },

  "delegation": {
    "description": "Rights below Domain Admins. See ad/README.md, Delegation.",
    "grants": [
      { "group": "DL-Users-PasswordReset", "rights": "user-helpdesk",
        "ous": ["Users/Staff", "Users/Board-Only", "Users/Sponsored-Projects"] },
      { "group": "DL-Servers-ComputerAdmin", "rights": "computer-admin", "ous": ["Servers", "Computers"] },
      { "principal": "svc-weave-ldap", "rights": "weave-password",
        "ous": ["Users/Staff", "Users/Board-Only", "Users/Sponsored-Projects"] },
      { "principal": "svc-weave-ldap", "rights": "weave-members", "ous": ["Users/Members"] }
    ],
    "deny": [
      { "ous": ["Admin-Accounts", "Service-Accounts"], "principals": ["DL-Users-PasswordReset", "DL-Servers-ComputerAdmin", "svc-weave-ldap"] },
      { "ous": ["Servers/Tier0"], "principals": ["DL-Users-PasswordReset", "DL-Servers-ComputerAdmin", "svc-lnx-join", "svc-weave-ldap"] },
      { "ous": ["Disabled"], "principals": ["svc-weave-ldap"] }
    ],
    "noDelegation": ["Admin-Accounts", "Admin-Accounts/Tier0", "Admin-Accounts/Tier1", "Admin-Accounts/Tier2",
      "Service-Accounts", "Servers/Tier0", "Disabled"],
    "knownAces": [
      { "principal": "svc-lnx-join", "ous": ["Servers", "Computers"], "why": "ansible/ad.yml -t join-delegation" }
    ],
    "expectAdminCount": ["adm_mayonej", "svc-ansible"]
  },

  "migration": {
    "oldRoot": "Patchwork-Objects",
    "ouMap": [
      { "from": "",                                                "to": "" },
      { "from": "Staff-Production",                                "to": "Users/Staff" },
      { "from": "Staff-Production/Staff-Computers",                "to": "Computers" },
      { "from": "Infrastructure",                                  "to": "Servers" },
      { "from": "Infrastructure/Member-Servers",                   "to": "Servers" },
      { "from": "Security-Groups",                                 "to": "Groups" },
      { "from": "Security-Groups/Linux-Access-Control",            "to": "Groups/Resources" },
      { "from": "Security-Groups/Linux-Access-Control/Box-Users",  "to": "Groups/Resources" },
      { "from": "Security-Groups/Linux-Access-Control/Box-Admins", "to": "Groups/Resources" },
      { "from": "Security-Groups/App-Access-Control",              "to": "Groups/Resources" },
      { "from": "Service-Accounts",                                "to": "Service-Accounts" },
      { "from": "Governance",                                      "to": "Users/Board-Only" },
      { "from": "Governance/Board-of-Directors",                   "to": "Users/Board-Only" },
      { "from": "Administrative",                                  "to": "Admin-Accounts" },
      { "from": "Administrative/Admin-Accounts",                   "to": "Admin-Accounts" },
      { "from": "Members",                                         "to": "Users/Members" }
    ]
  }
}
