#!/usr/bin/env bash
# Write Selvage staging's secrets:
#   secrets/restricted-staging-selvage.age  the password of the role selvage in
#                                           patchwork_central_restricted on
#                                           hem:5433 (password only, a new
#                                           random value)
#   secrets/selvage-staging-env.age         Selvage staging's env file
# The registry token is shared with production (selvage-ghcr-token.age), so
# this script does not write one.
#
# The env file gets:
#   CENTRAL_DATABASE_URL     hem:5432, with the password that already exists in
#                            central-staging-selvage.age (hem sets it on the
#                            role). The script decrypts that file with your
#                            age identity, into a shell variable only.
#   RESTRICTED_DATABASE_URL  hem:5433, with the new password above.
#   SECRET_KEY_BASE          a new random value, not production's.
#   WEAVE_ISSUER             https://weave-staging.patchworklabs.org (not
#                            secret; hosts/twill/selvage.nix also sets it).
#   SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, SLACK_ADMIN_TOKEN,
#   SLACK_BROWSER_TOKEN, SLACK_BROWSER_COOKIE, WEAVE_CLIENT_ID,
#   WEAVE_CLIENT_SECRET and SELVAGE_AUDIT_CHANNEL only when they are set in
#   the environment. They are the STAGING values: the staging Slack app in the
#   staging workspace and the Selvage app in Weave staging. Never production's.
#     set -a; . ./selvage-staging-third-party.env; set +a; bin/new-selvage-staging-secrets
#   A key that is not set is left out of the file, never written empty: an
#   empty SLACK_SIGNING_SECRET would let anyone sign a Slack request.
#   modules/selvage does not start Selvage staging until the Slack keys are
#   set. Fill them in later with (asks for each value with the echo off)
#     bin/set-env-secret selvage-staging-env.age SLACK_SIGNING_SECRET SLACK_BOT_TOKEN ...
#   or: cd secrets && agenix -e selvage-staging-env.age
#
# Usage: bin/new-selvage-staging-secrets
# Needs age, nix and openssl. The identity that decrypts
# central-staging-selvage.age is $AGE_IDENTITY, or ~/.ssh/id_ed25519, as for
# bin/set-env-secret. The script never prints a value, and it stops if the
# password file or the env file exists. The recipients come from
# secrets/secrets.nix: the script encrypts with `age` itself, because
# `agenix -e` from a pipe fails on macOS.
set -euo pipefail
# No trace, even under `bash -x` or SHELLOPTS=xtrace: a trace shows the values.
set +x

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/secrets"

db_file=restricted-staging-selvage.age
env_file=selvage-staging-env.age
central_file=central-staging-selvage.age
db_host=hem.wildebeest-stargazer.ts.net
identity="${AGE_IDENTITY:-$HOME/.ssh/id_ed25519}"
optional_keys=(SLACK_SIGNING_SECRET SLACK_BOT_TOKEN SLACK_ADMIN_TOKEN SLACK_BROWSER_TOKEN
  SLACK_BROWSER_COOKIE WEAVE_CLIENT_ID WEAVE_CLIENT_SECRET SELVAGE_AUDIT_CHANNEL)

for tool in age nix openssl; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

if [ ! -r "$identity" ]; then
  echo "No age identity at $identity. Set AGE_IDENTITY to the key that decrypts $central_file." >&2
  exit 1
fi

# Encrypts stdin to the recipients that secrets.nix lists for the file.
# $1 names the file in secrets.nix, $2 is where the ciphertext goes.
encrypt() {
  local file="$1" out="$2" recipients
  recipients="$(nix eval --raw -f secrets.nix "\"$file\".publicKeys" --apply 'keys: builtins.concatStringsSep "\n" keys')"
  if [ -z "$recipients" ]; then
    echo "secrets.nix lists no recipients for $file. Stop." >&2
    exit 1
  fi
  age --encrypt --recipients-file <(printf '%s\n' "$recipients") --output "$out"
  chmod 644 "$out"
}

# Percent-encodes a URL userinfo part. Hex passwords pass through unchanged.
urlencode() {
  # Bytes, not characters, so a multibyte character becomes one %XX per byte.
  local LC_ALL=C
  local s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [A-Za-z0-9._~-]) out+="$c" ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

for file in "$db_file" "$env_file"; do
  if [ -e "$file" ]; then
    echo "secrets/$file exists. Stop. To change a value, use: bin/set-env-secret or agenix -e $file" >&2
    exit 1
  fi
done
if [ ! -e "$central_file" ]; then
  echo "secrets/$central_file does not exist. Stop." >&2
  exit 1
fi

umask 077

# Read every input before anything is written, so a failed decrypt (a wrong
# passphrase) leaves no file behind. The plaintext lives in variables only.
# $(...) drops the trailing newline.
central_password="$(age --decrypt -i "$identity" "$central_file")"
if [ -z "$central_password" ]; then
  echo "secrets/$central_file decrypted to an empty value. Stop." >&2
  exit 1
fi

# Hex only, so the password needs no escaping in the URL.
restricted_password="$(openssl rand -hex 32)"
secret_key_base="$(openssl rand -hex 64)"

# Encrypt to temporary names, then move all of them into place at the end.
tmpdir="$(mktemp -d "$PWD/.new-selvage-staging-secrets.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

# printf is a shell builtin, so the values are not in any process's arguments.
{
  printf '%s\n' "CENTRAL_DATABASE_URL=postgres://selvage:$(urlencode "$central_password")@${db_host}:5432/patchwork_central?sslmode=disable"
  printf '%s\n' "RESTRICTED_DATABASE_URL=postgres://selvage:${restricted_password}@${db_host}:5433/patchwork_central_restricted?sslmode=disable"
  printf '%s\n' "SECRET_KEY_BASE=${secret_key_base}"
  printf '%s\n' "WEAVE_ISSUER=https://weave-staging.patchworklabs.org"
  for key in "${optional_keys[@]}"; do
    if [ -n "${!key:-}" ]; then
      printf '%s=%s\n' "$key" "${!key}"
    fi
  done
} | encrypt "$env_file" "$tmpdir/$env_file"

printf '%s' "$restricted_password" | encrypt "$db_file" "$tmpdir/$db_file"
unset central_password restricted_password secret_key_base

written="secrets/$env_file and secrets/$db_file"
mv "$tmpdir/$env_file" "$env_file"
mv "$tmpdir/$db_file" "$db_file"

echo "Wrote $written."
missing=""
for key in SLACK_SIGNING_SECRET SLACK_BOT_TOKEN SLACK_ADMIN_TOKEN WEAVE_CLIENT_ID \
  WEAVE_CLIENT_SECRET SELVAGE_AUDIT_CHANNEL; do
  if [ -z "${!key:-}" ]; then
    missing="$missing $key"
  fi
done
if [ -n "$missing" ]; then
  echo "Not set:$missing"
  echo "Set them before the merge, with: bin/set-env-secret $env_file$missing"
  echo "Selvage staging does not start without SLACK_SIGNING_SECRET and SLACK_BOT_TOKEN."
fi
echo "Next: commit the files. The merge deploys hem, which sets the selvage role's password on 5433."
