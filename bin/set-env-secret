#!/usr/bin/env bash
# Set one or more keys in an agenix env file, for example the Weave client id
# and secret of a Stash instance after the app exists in Weave:
#   bin/set-env-secret stash-env.age WEAVE_CLIENT_ID WEAVE_CLIENT_SECRET
# The script asks for each value on the terminal with the echo off, and it
# never prints a value. A key that the file has is replaced in place, and a
# key that it lacks is appended. The other lines stay as they are.
#
# The file is decrypted into a shell variable only, not onto disk, and it is
# encrypted again for the recipients that secrets/secrets.nix lists for it.
# The script uses `age` itself, as bin/new-stash-secrets does, because
# `agenix -e` from a pipe fails on macOS.
#
# Usage: bin/set-env-secret <file.age> KEY [KEY...]
# The file is a name in secrets/, or a path. The identity that decrypts it is
# $AGE_IDENTITY, or ~/.ssh/id_ed25519.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: $0 <file.age> KEY [KEY...]" >&2
  exit 1
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
file="$1"
shift
case "$file" in
  */*) ;;
  *) file="$root/secrets/$file" ;;
esac
if [ ! -f "$file" ]; then
  echo "$file does not exist. bin/new-stash-secrets makes a new env file." >&2
  exit 1
fi
name="$(basename "$file")"
identity="${AGE_IDENTITY:-$HOME/.ssh/id_ed25519}"

for tool in age nix; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

for key in "$@"; do
  if ! [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "$key is not an env var name." >&2
    exit 1
  fi
done

recipients="$(cd "$root/secrets" && nix eval --raw -f secrets.nix "\"$name\".publicKeys" \
  --apply 'keys: builtins.concatStringsSep "\n" keys')"
if [ -z "$recipients" ]; then
  echo "secrets/secrets.nix lists no recipients for $name. Stop." >&2
  exit 1
fi

# The plaintext lives in this variable only.
content="$(age --decrypt -i "$identity" "$file")"

for key in "$@"; do
  if [ -t 0 ]; then
    read -r -s -p "$key: " value
    echo >&2
  else
    read -r value
  fi
  if [ -z "$value" ]; then
    echo "$key: empty value. Nothing was written." >&2
    exit 1
  fi
  if printf '%s' "$content" | grep -q "^$key="; then
    # awk gets the value through its environment, not through its program text.
    content="$(printf '%s\n' "$content" | KEY="$key" VALUE="$value" \
      awk 'index($0, ENVIRON["KEY"] "=") == 1 { print ENVIRON["KEY"] "=" ENVIRON["VALUE"]; next } { print }')"
  else
    content="$(printf '%s\n%s=%s' "$content" "$key" "$value")"
  fi
  unset value
done

umask 077
tmp="$(mktemp "$file.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$content" | age --encrypt --recipients-file <(printf '%s\n' "$recipients") --output "$tmp"
unset content
chmod 644 "$tmp"
mv "$tmp" "$file"
trap - EXIT

echo "Wrote $file: $*"
echo "Commit it, and after the host picks it up, restart the service that reads it."
