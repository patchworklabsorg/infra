#!/usr/bin/env bash
# Write the two Quilt staging secrets with new random values:
#   secrets/restricted-staging-quilt.age  the password of the role quilt on
#                                         hem:5433 (password only)
#   secrets/quilt-staging-env.age         the Quilt staging env file
# Both files get the same password. The env file also gets a new
# SECRET_KEY_BASE. WEAVE_CLIENT_ID, WEAVE_CLIENT_SECRET, MERCURY_API_TOKEN and
# MERCURY_WRITE_TOKEN stay empty. Fill them in later with
#   cd secrets && agenix -e quilt-staging-env.age
# MERCURY_API_BASE and WEAVE_ISSUER are not in the file: hosts/alastor/quilt.nix
# sets them.
#
# Usage: bin/new-quilt-staging-secrets
# Needs agenix and openssl. The script never prints a value, and it stops if
# one of the files exists. The recipients come from secrets/secrets.nix, so
# after hem's install, add hem there and run `agenix -r`.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/secrets"

for tool in agenix openssl; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

for file in restricted-staging-quilt.age quilt-staging-env.age; do
  if [ -e "$file" ]; then
    echo "secrets/$file exists. Stop. To change a value, use: agenix -e $file" >&2
    exit 1
  fi
done

umask 077
# Hex only, so the password needs no escaping in the URL.
password="$(openssl rand -hex 32)"
secret_key_base="$(openssl rand -hex 64)"

# printf is a shell builtin, so the values are not in any process's arguments.
# agenix reads the cleartext from stdin when stdin is not a terminal.
printf '%s' "$password" | agenix -e restricted-staging-quilt.age

{
  printf '%s\n' "RESTRICTED_DATABASE_URL=postgres://quilt:${password}@hem.wildebeest-stargazer.ts.net:5433/patchwork_central_restricted?sslmode=disable"
  printf '%s\n' "SECRET_KEY_BASE=${secret_key_base}"
  printf '%s\n' "WEAVE_CLIENT_ID="
  printf '%s\n' "WEAVE_CLIENT_SECRET="
  printf '%s\n' "MERCURY_API_TOKEN="
  printf '%s\n' "MERCURY_WRITE_TOKEN="
  printf '%s\n' "QUILT_TOPUPS=off"
} | agenix -e quilt-staging-env.age

unset password secret_key_base

echo "Wrote secrets/restricted-staging-quilt.age and secrets/quilt-staging-env.age."
echo "Next: add the Weave staging client and the Mercury sandbox token with"
echo "  cd secrets && agenix -e quilt-staging-env.age"
