#!/usr/bin/env bash
# Write Krater's two secrets for one environment with new random values.
#   staging:    secrets/central-staging-krater.age  the role krater's password
#                                                   in patchwork_central on hem
#               secrets/krater-staging-env.age      Krater's env file
#   production: secrets/central-prod-krater.age     the same on skein
#               secrets/krater-env.age
# Only staging runs today (hosts/weft/krater.nix).
# Both files get the same password. The env file also gets a new
# KRATER_SECRET_KEY and screenshot-storage keys. KRATER_WEAVE_CLIENT_SECRET,
# KRATER_SLACK_BOT_TOKEN and KRATER_SLACK_SIGNING_SECRET come from the
# environment when they are set there, e.g.
#   set -a; . ./krater-third-party.env; set +a; bin/new-krater-secrets staging
# and are left empty otherwise. Krater refuses to start in production until
# they are set. Only the file's recipients (Jasper, weft) can fill them in
# later, with
#   cd secrets && agenix -e krater-staging-env.age
# The Weave client id, the issuer and the hostnames are not secret:
# hosts/weft/krater.nix sets them.
#
# Usage: bin/new-krater-secrets staging|production [database host]
# The database host defaults to hem's (staging) or skein's (production)
# tailnet name, for a Krater host that reaches it over Tailscale (weft, with
# the name pinned in extraHosts).
# Needs agenix and openssl. The script never prints a value, and it stops if
# one of the files exists. The recipients come from secrets/secrets.nix.
set -euo pipefail

case "${1:-}" in
  staging)
    db_file=central-staging-krater.age
    env_file=krater-staging-env.age
    db_host="${2:-hem.wildebeest-stargazer.ts.net}"
    s3_key_id=krater-staging
    ;;
  production)
    db_file=central-prod-krater.age
    env_file=krater-env.age
    db_host="${2:-skein.wildebeest-stargazer.ts.net}"
    s3_key_id=krater-prod
    ;;
  *)
    echo "Usage: $0 staging|production [database host]" >&2
    exit 1
    ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/secrets"

for tool in agenix openssl; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

for file in "$db_file" "$env_file"; do
  if [ -e "$file" ]; then
    echo "secrets/$file exists. Stop. To change a value, use: agenix -e $file" >&2
    exit 1
  fi
done

umask 077
# Hex only, so the password needs no escaping in the URL.
password="$(openssl rand -hex 32)"
secret_key="$(openssl rand -hex 32)"
s3_secret="$(openssl rand -hex 32)"

# printf is a shell builtin, so the values are not in any process's arguments.
# agenix reads the cleartext from stdin when stdin is not a terminal.
printf '%s' "$password" | agenix -e "$db_file"

{
  printf '%s\n' "KRATER_DATABASE_URL=postgresql+psycopg://krater:${password}@${db_host}:5432/patchwork_central?sslmode=disable"
  printf '%s\n' "KRATER_SECRET_KEY=${secret_key}"
  printf '%s\n' "KRATER_S3_ACCESS_KEY_ID=${s3_key_id}"
  printf '%s\n' "KRATER_S3_SECRET_ACCESS_KEY=${s3_secret}"
  printf '%s\n' "KRATER_WEAVE_CLIENT_SECRET=${KRATER_WEAVE_CLIENT_SECRET:-}"
  printf '%s\n' "KRATER_SLACK_BOT_TOKEN=${KRATER_SLACK_BOT_TOKEN:-}"
  printf '%s\n' "KRATER_SLACK_SIGNING_SECRET=${KRATER_SLACK_SIGNING_SECRET:-}"
} | agenix -e "$env_file"

unset password secret_key s3_secret

echo "Wrote secrets/$db_file and secrets/$env_file."
missing=""
for key in KRATER_WEAVE_CLIENT_SECRET KRATER_SLACK_BOT_TOKEN KRATER_SLACK_SIGNING_SECRET; do
  if [ -z "${!key:-}" ]; then
    missing="$missing $key"
  fi
done
if [ -n "$missing" ]; then
  echo "Left empty:$missing"
  echo "Jasper fills them in with: cd secrets && agenix -e $env_file"
fi
