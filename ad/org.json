  "domain": "patchwork.internal",
  "upnSuffix": "patchworklabs.org",
  "company": "Patchwork Labs inc.",
  "root": "Patchwork",

  "divisions": {
    "Programs": ["Programs", "Project Ganymede"],
    "Sponsored Projects": ["HackBoston", "hackathon.help"],
    "Operations": ["Governance", "Administration", "Infrastructure"],
    "Development": ["Grants & Partnerships"]
  },

  "ous": [
    { "path": "Users", "description": "People. Placement is for policy, not the org chart." },
    { "path": "Users/Staff", "description": "Staff and volunteers with operational roles" },
    { "path": "Users/Board-Only", "description": "Directors with no operational role" },
    { "path": "Users/Sponsored-Projects", "description": "Fiscally sponsored projects" },
    { "path": "Users/Sponsored-Projects/HackBoston", "description": "HackBoston (hackboston.dev)", "upnSuffix": "hackboston.dev" },
    { "path": "Users/Sponsored-Projects/hackathon.help", "description": "hackathon.help", "upnSuffix": "hackathon.help" },
    { "path": "Users/Members", "description": "Community members. Weave creates and changes these; converge.ps1 does not.", "managed": false },
    { "path": "Service-Accounts", "description": "Non-human accounts for integrations" },
    { "path": "Disabled", "description": "Suspended users, all access off (Workspace: Purgatory)" },
    { "path": "Admin-Accounts", "description": "Tier 0. Separate from daily accounts." },
    { "path": "Groups", "description": "Security groups (AGDLP)" },
    { "path": "Groups/Roles", "description": "Global groups. People go here." },
    { "path": "Groups/Resources", "description": "Domain local groups. Only these get permissions." },
    { "path": "Computers", "description": "Staff workstations" },
    { "path": "Servers", "description": "Member servers and lab hosts" }
  ],

