    { "sam": "daniel", "kind": "person", "ou": "Users/Sponsored-Projects/HackBoston",
      "division": "Sponsored Projects", "department": "HackBoston", "title": "Organizer", "manager": null },
    { "sam": "logan", "kind": "person", "ou": "Users/Sponsored-Projects/HackBoston",
      "division": "Sponsored Projects", "department": "HackBoston", "title": "Organizer", "manager": null },
    { "sam": "wei", "kind": "person", "ou": "Users/Sponsored-Projects/hackathon.help",
      "division": "Sponsored Projects", "department": "hackathon.help", "title": "Organizer", "manager": null },

    { "sam": "svc-service", "upn": "service", "kind": "service", "ou": "Service-Accounts",
      "company": "Patchwork Labs inc.", "division": "Operations", "department": "Infrastructure", "title": "Service account", "manager": null },
    { "sam": "svc-lnx-join", "kind": "service", "ou": "Service-Accounts", "create": false },
    { "sam": "svc-dhcp-dns", "kind": "service", "ou": "Service-Accounts", "create": false },
    { "sam": "svc-pve-ldap", "kind": "service", "ou": "Service-Accounts", "create": false },
    { "sam": "svc-weave-ldap", "kind": "service", "ou": "Service-Accounts",
