---
# yamllint for the Ansible tree. ansible-lint reads this file too.
extends: default

ignore: |
  inventory/group_vars/all/vault.yml
  vault/
  .worktrees/
  .ansible/
  .git/

rules:
  line-length:
    max: 160
    allow-non-breakable-inline-mappings: true
  # Aligned values ("key:      value") and aligned inline lists are used on
  # purpose for readability in inventory and module argument blocks.
  colons:
    max-spaces-after: -1
  commas:
    max-spaces-after: -1
  braces:
    max-spaces-inside: 1
  # Ansible uses yes/no and on/off in a few module arguments.
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  indentation:
    spaces: 2
    indent-sequences: consistent
  document-start:
    present: true
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
