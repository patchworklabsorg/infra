#!/usr/bin/env bash
# Write one Stash instance's two secrets with new random values:
#   staging     secrets/central-staging-stash.age  the password of the role
#                                                  stash in patchwork_central
#                                                  on hem (password only)
#               secrets/stash-staging-env.age      Stash staging's env file
#   production  secrets/central-prod-stash.age     the same on skein
#               secrets/stash-env.age              Stash production's env file
# Both files get the same password. The env file also gets a new
# SECRET_KEY_BASE. WEAVE_CLIENT_ID, WEAVE_CLIENT_SECRET and GITHUB_TOKEN come
# from the environment when they are set there, e.g.
#   set -a; . ./stash-third-party.env; set +a; bin/new-stash-secrets staging
# and are left empty otherwise. Only the file's recipients (Jasper, hank) can
# fill them in later, with
#   cd secrets && agenix -e stash-staging-env.age
# The issuer and the hostnames are not secret: hosts/hank/stash.nix sets
# staging's, and production's are in the env file as plain values.
#
# Usage: bin/new-stash-secrets staging|production [database host]
# The database host defaults to hem's (staging) or skein's (production)
# tailnet name, for a Stash host that reaches it over Tailscale (hank, with
# the name pinned in networking.hosts).
# Needs age, nix and openssl. The script never prints a value, and it stops if
# one of the files exists. The recipients come from secrets/secrets.nix: the
# script encrypts with `age` itself, because `agenix -e` from a pipe fails on
# macOS ("cp: skipping file '/dev/stdin'") and reports nothing.
set -euo pipefail

case "${1:-}" in
  staging)
    db_file=central-staging-stash.age
    env_file=stash-staging-env.age
    db_host="${2:-hem.wildebeest-stargazer.ts.net}"
    hosts=stash-staging.patchworklabs.org
    issuer=https://weave-staging.patchworklabs.org
    ;;
  production)
    db_file=central-prod-stash.age
    env_file=stash-env.age
    db_host="${2:-skein.wildebeest-stargazer.ts.net}"
    hosts=stash.patchworklabs.org
    issuer=https://weave.patchworklabs.org
    ;;
  *)
    echo "Usage: $0 staging|production [database host]" >&2
    exit 1
    ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/secrets"

for tool in age nix openssl; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not on PATH. Run this script in a shell that has it." >&2
    exit 1
  fi
done

# Encrypts stdin to the recipients that secrets.nix lists for the file.
encrypt() {
  local file="$1" recipients
  recipients="$(nix eval --raw -f secrets.nix "\"$file\".publicKeys" --apply 'keys: builtins.concatStringsSep "\n" keys')"
  if [ -z "$recipients" ]; then
    echo "secrets.nix lists no recipients for $file. Stop." >&2
    exit 1
  fi
  age --encrypt --recipients-file <(printf '%s\n' "$recipients") --output "$file"
  chmod 644 "$file"
}

for file in "$db_file" "$env_file"; do
  if [ -e "$file" ]; then
    echo "secrets/$file exists. Stop. To change a value, use: agenix -e $file" >&2
    exit 1
  fi
done

umask 077
# Hex only, so the password needs no escaping in the URL.
password="$(openssl rand -hex 32)"
secret_key_base="$(openssl rand -hex 64)"

# printf is a shell builtin, so the values are not in any process's arguments.
printf '%s' "$password" | encrypt "$db_file"

{
  printf '%s\n' "CENTRAL_DATABASE_URL=postgres://stash:${password}@${db_host}:5432/patchwork_central?sslmode=disable"
  printf '%s\n' "SECRET_KEY_BASE=${secret_key_base}"
  printf '%s\n' "STASH_HOSTS=${hosts}"
  printf '%s\n' "WEAVE_ISSUER=${issuer}"
  printf '%s\n' "WEAVE_CLIENT_ID=${WEAVE_CLIENT_ID:-}"
  printf '%s\n' "WEAVE_CLIENT_SECRET=${WEAVE_CLIENT_SECRET:-}"
  printf '%s\n' "GITHUB_TOKEN=${GITHUB_TOKEN:-}"
} | encrypt "$env_file"

unset password secret_key_base

echo "Wrote secrets/$db_file and secrets/$env_file."
missing=""
for key in WEAVE_CLIENT_ID WEAVE_CLIENT_SECRET; do
  if [ -z "${!key:-}" ]; then
    missing="$missing $key"
  fi
done
if [ -n "$missing" ]; then
  echo "Left empty:$missing"
  echo "Jasper fills them in with: cd secrets && agenix -e $env_file"
fi
